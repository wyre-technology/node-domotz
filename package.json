{
  "name": "@wyre-technology/node-domotz",
  "version": "1.0.0",
  "description": "Node.js client library for the Domotz network monitoring API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "msw": "^2.15.0",
    "eslint": "^10.8.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.65.0"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyre-technology/node-domotz"
  }
}
